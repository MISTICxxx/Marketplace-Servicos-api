# API local
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Autenticação: substitua por um segredo aleatório apenas no api/.env local.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Banco de desenvolvimento isolado exigido pelos guardas dos scripts de demo.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=33317
MYSQL_USER=fechou_app
MYSQL_PASSWORD=replace-with-a-local-mysql-password
MYSQL_DATABASE=fechou_dev
MYSQL_CONNECTION_LIMIT=10

# Defina uma senha fictícia exclusiva no api/.env antes de executar o seed.
FECHOU_DEMO_PASSWORD=replace-with-a-unique-demo-password
